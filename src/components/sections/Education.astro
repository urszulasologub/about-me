---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import SpotlightCard from '@/components/ui/SpotlightCard.astro';
import { education } from '@/data/experience';
import { languages } from '@/data/profile';
---

<section class="section" id="education">
  <div class="container">
    <SectionHeading
      index="06"
      eyebrow="Education & languages"
      title="Learning, and <em>talking</em>"
    />

    <div class="grid">
      <div class="col">
        <h3 class="col__title">Education</h3>
        {
          education.map((item) => (
            <SpotlightCard>
              <p class="edu__degree">{item.degree}</p>
              <p class="edu__field serif">{item.field}</p>
              <p class="edu__school">
                {item.school}
                {item.period && <span> · {item.period}</span>}
              </p>
              {item.note && <p class="edu__note">{item.note}</p>}
            </SpotlightCard>
          ))
        }
      </div>

      <div class="col">
        <h3 class="col__title">Languages</h3>
        <ul class="langs">
          {
            languages.map((lang, i) => (
              <li class="lang" data-reveal style={`--reveal-i: ${i}`}>
                <div class="lang__head">
                  <span class="lang__name serif">{lang.name}</span>
                  <span class="lang__level">{lang.level}</span>
                </div>
                <span class="meter" aria-hidden="true">
                  <span style={`--value: ${lang.meter / 100}`} />
                </span>
                <p class="lang__note">{lang.note}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .section {
    padding-block: var(--section-gap);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 4rem);
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .col__title {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .edu__degree {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ruby);
  }

  .edu__field {
    margin-top: 0.4rem;
    font-size: var(--step-2);
    line-height: 1.1;
  }

  .edu__school {
    margin-top: 0.5rem;
    color: var(--text-muted);
  }

  .edu__note {
    margin-top: 1rem;
    font-size: var(--step--1);
    color: var(--text-faint);
  }

  .langs {
    display: grid;
    gap: 1.75rem;
  }

  .lang__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .lang__name {
    font-size: var(--step-2);
  }

  .lang__level {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .meter {
    display: block;
    height: 2px;
    margin-top: 0.75rem;
    border-radius: 2px;
    background: var(--border);
    overflow: hidden;
  }

  .meter span {
    display: block;
    height: 100%;
    background: var(--accent-gradient);
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 1.4s var(--ease-out) 200ms;
  }

  :global(.is-visible) .meter span,
  :global(html:not(.js)) .meter span {
    transform: scaleX(var(--value));
  }

  .lang__note {
    margin-top: 0.75rem;
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
